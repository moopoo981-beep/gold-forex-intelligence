# FREE AI OPTION: create a Gemini API key at https://aistudio.google.com/apikey
# Keep this key private. Add it to Render Environment Variables, not to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Twelve Data quote provider. Leave blank to use the Yahoo Finance fallback.
TWELVEDATA_API_KEY=

# Optional: official FRED API key. Leave blank to use FRED's CSV download fallback.
FRED_API_KEY=

# Protect the public dashboard. Set a long, unique password in Render.
DASHBOARD_PASSWORD=

# API abuse protection
ANALYZE_MAX_PER_HOUR=4

PORT=3000
AUTO_ANALYZE=true
AUTO_ANALYZE_MINUTES=60
